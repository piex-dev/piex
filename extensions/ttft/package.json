  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piex-dev/piex.git",
    "directory": "extensions/ttft"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "ttft",
    "time-to-first-token",
    "latency",
    "throughput",
    "tokens-per-second",
    "cache-hit",
    "status-bar"
  ],
  "pi": {
    "extensions": [
      "./src/ttft.ts"
    ]
  },
