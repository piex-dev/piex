{
  "rust-analyzer": {
    "command": "rust-analyzer",
    "args": [],
    "fileTypes": [
      ".rs"
    ],
    "rootMarkers": [
      "Cargo.toml",
      "rust-analyzer.toml"
    ],
    "initOptions": {},
    "settings": {
      "rust-analyzer": {
        "checkOnSave": false
      }
    },
    "capabilities": {
      "flycheck": true,
      "ssr": true,
      "expandMacro": true,
      "runnables": true,
      "relatedTests": true
    },
    "install": {
