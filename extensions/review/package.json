{
  "name": "@piex-dev/review",
  "version": "0.4.0",
  "type": "module",
  "description": "Independent, evidence-gated code review for Pi with one simple /review command",
  "license": "MIT",
  "author": "debugtalk",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piex-dev/piex.git",
    "directory": "extensions/review"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "review",
    "code-review",
    "diff"
  ],
  "pi": {
    "extensions": [
      "./src/review-v2.ts"
    ]
  },
  "exports": {
    ".": "./src/review-v2.ts"
  },
  "files": [
    "src/diff.ts",
    "src/findings.ts",
    "src/progress.ts",
    "src/render.ts",
    "src/review-v2.ts",
    "src/reviewer.ts",
    "src/scope.ts",
    "src/state.ts",
    "src/transcript.ts",
    "src/transcript-viewer.ts",
    "src/types.ts",
    "README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "typebox": "*"
  }
}
